---
import { AgentPicker } from "../components/AgentPicker";
import { CommandBlock } from "../components/CommandBlock";
import Figure from "../components/Figure.astro";
import Hero from "../components/Hero.astro";
import { PromptBlock } from "../components/PromptBlock";
import { StepNav } from "../components/StepNav";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMMANDS, LEARNING_OBJECTIVES, LINKS, MCP_AGENTS, PROMPTS, REPO_URL, STEPS } from "../lib/site";

const stepByIndex = (i: number) => STEPS[i];
---

<BaseLayout>
	<Hero slot="hero" />
	<StepNav slot="nav" client:load />

	<section class="intro-card">
		<h2 class="intro-title">What you'll learn</h2>
		<ul class="intro-objectives">
			{LEARNING_OBJECTIVES.map((objective) => <li>{objective}</li>)}
		</ul>
	</section>

	{/* ─── Step 0: Prereqs ─── */}
	<article id="prereqs" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(0).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(0).label}</h2>
				<p class="stepcard-lede">Paste this into your coding agent. It checks your machine and helps you fix anything missing.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<ul class="step-facts" aria-label="What your agent will do">
				<li>
					<span class="step-facts-label">Checks</span>
					<span>Node, git, the GitHub CLI, and Wrangler.</span>
				</li>
				<li>
					<span class="step-facts-label">Asks first</span>
					<span>Before it installs or updates anything.</span>
				</li>
				<li>
					<span class="step-facts-label">You sign in</span>
					<span>GitHub and Cloudflare logins open your browser. You run them.</span>
				</li>
			</ul>

			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.checkPrereqs} />

			<p class="step-success">You should see a table of your tools and <strong>Ready</strong>.</p>
		</div>
	</article>

	{/* ─── Step 1: Deploy ─── */}
	<article id="deploy" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(1).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(1).label}</h2>
				<p class="stepcard-lede">One click creates your copy of the repo, a production D1 database, and a live Worker with Preview builds on.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="deploy-panel">
				<a
					href={`https://deploy.workers.cloudflare.com/?url=${REPO_URL}`}
					target="_blank"
					rel="noopener noreferrer"
					class="deploy-cta-link"
				>
					<img src="https://deploy.workers.cloudflare.com/button" alt="Deploy to Cloudflare" />
				</a>
				<ol class="deploy-panel-steps">
					<li><span>Pick a personal GitHub account</span></li>
					<li><span>Keep the default names</span></li>
					<li><span>Database: choose <strong>Create new</strong></span></li>
					<li><span>Click <strong>Deploy</strong></span></li>
				</ol>
			</div>

			<details class="aside">
				<summary>See each screen of the form</summary>
				<div class="aside-body">
					<Figure
						src="/screenshots/deploy-01-github.png"
						width={1400}
						height={647}
						alt="The Git account dropdown in the deploy form, listing connected GitHub and GitLab accounts and options to add a new connection."
						caption="1. Pick the Git account for your copy of the repo. Use a personal GitHub account; work organizations with SSO can block the Cloudflare GitHub app install."
					/>
					<Figure
						src="/screenshots/deploy-02-form.png"
						width={1400}
						height={639}
						alt="The deploy form with project name worker-previews-starter, Create new selected for the D1 database, and the database named activity-log-db."
						caption="2. Keep the default project name, choose Create new, and keep the database name activity-log-db."
					/>
					<Figure
						src="/screenshots/deploy-03-build-settings.png"
						width={1400}
						height={642}
						alt="The deploy form showing ENVIRONMENT set to production, an empty build command, deploy command npm run deploy, and preview command npx wrangler preview."
						caption="3. Leave ENVIRONMENT as production and the commands as they are."
					/>
					<Figure
						src="/screenshots/deploy-04-preview-settings.png"
						width={1400}
						height={646}
						alt="The bottom of the deploy form with Enable Preview builds switched on and Protect with Cloudflare Access switched off, next to the Deploy button."
						caption="4. Check that Enable Preview builds is on, then click Deploy."
					/>
				</div>
			</details>

			<p class="step-success">When the build says <strong>Success</strong>, click <strong>Visit</strong>. You should see a <strong>Production</strong> badge and three entries. Build log stuck? Refresh the page.</p>
		</div>
	</article>

	{/* ─── Step 2: Clone ─── */}
	<article id="clone" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(2).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(2).label}</h2>
				<p class="stepcard-lede">The deploy button created a repo in your GitHub account and deployed it to Cloudflare. Your agent works on your machine, so get a local copy.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.clone} />

			<p class="step-success">You should see a short summary of the app and the folder's path.</p>

			<div class="step-required" role="note">
				<span class="step-required-icon" aria-hidden="true">↻</span>
				<div>
					<p class="step-required-title">Restart your agent inside that folder</p>
					<p class="step-required-body">Your agent gave you the commands. It only loads the repo's rules and log tools when it starts there, and the next steps need them.</p>
				</div>
			</div>
		</div>
	</article>

	{/* ─── Step 3: Isolate ─── */}
	<article id="isolate" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(3).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(3).label}</h2>
				<p class="stepcard-lede">Previews inherit your code, not your settings. A Preview never falls back to production's database, so until you give it one, it has none.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="concept-diagram">
				<div class="concept-col">
					<span class="concept-col-head concept-col-head--prod">Production</span>
					<div class="concept-cell">code</div>
					<div class="concept-cell concept-cell--bind">DB → activity-log-db</div>
				</div>
				<div class="concept-col">
					<span class="concept-col-head concept-col-head--preview">Preview</span>
					<div class="concept-cell concept-cell--inherit">code (inherited)</div>
					<div class="concept-cell concept-cell--empty">DB → nothing until you add it</div>
				</div>
			</div>

			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.configure} />

			<div class="tip">
				<span class="tip-label">Compare the two DB bindings</span>
				<p>Your agent shows <code>DB</code> twice. The top-level one points at <code>activity-log-db</code>: that's production. The one in <code>previews</code> points at <code>workshop-preview-db</code>. Same binding name, so the code doesn't change. Different database, so a Preview never touches production data.</p>
			</div>
		</div>
	</article>

	{/* ─── Step 4: Preview ─── */}
	<article id="preview" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(4).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(4).label}</h2>
				<p class="stepcard-lede">A pull request gets its own Preview: a separate copy of your Worker, with its own URL, running this branch's code and settings.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.openPullRequest} />

			<div class="tip">
				<span class="tip-label">Open both links</span>
				<p><strong>The PR first:</strong> scroll to the Cloudflare bot's comment. That's where your team finds the Preview.</p>
				<p><strong>Then the Preview URL:</strong> the badge says <strong>Preview</strong>, and the page says the database is connected but has no schema yet. That's your new Preview database: empty, and nothing to do with production's data. Keep this tab and production open. You'll compare them next.</p>
			</div>
			<Figure
				src="/screenshots/app-preview-needs-schema.png"
				width={960}
				height={360}
				alt="The Preview Activity Log with an orange Preview badge, explaining that its database is connected but doesn't have the workshop schema yet."
				caption="Expected: the new database is empty."
			/>
		</div>
	</article>

	{/* ─── Step 5: Prove ─── */}
	<article id="interact" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(5).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(5).label}</h2>
				<p class="stepcard-lede">Apply a Preview-only schema, then let your agent test the Preview.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="phase">
				<span class="phase-badge phase-badge--why">Learn</span>
				<div class="phase-content">
					<p>You're testing a schema change that production doesn't have, in a database production can't see.</p>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--do">Do</span>
				<div class="phase-content">
					<p>The schema file lives outside <code>migrations/</code>, so production deploys never apply it. Apply it to the Preview database by name:</p>
					<CommandBlock client:load text={COMMANDS.applyPreviewSchema} />
					<details class="aside aside--agent">
						<summary>Or ask your agent</summary>
						<div class="aside-body">
							<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.applyPreviewSchema} />
						</div>
					</details>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--verify">Verify</span>
				<div class="phase-content">
					<p>Refresh the Preview: three rows mentioning <strong>Preview</strong>. Click <strong>Delete</strong> on one. It fails, and that's the bug your agent is about to find.</p>
					<Figure
						src="/screenshots/app-preview-delete-error.png"
						width={960}
						height={828}
						size="narrow"
						alt="The Preview Activity Log with three Preview seed rows and a red error: Delete failed. Your data is unchanged. Check this Preview's Observability logs."
					/>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--do">Prompt</span>
				<div class="phase-content">
					<p>Now have your agent test it properly. The Preview has its own database, so the agent can add and delete data freely without any risk to production.</p>
					<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.testPreview} />
					<p>Expect listing and adding to work (<code>200</code>, <code>201</code>) and delete to return <code>500</code>.</p>
					<details class="aside aside--spoiler">
						<summary>Did something break?</summary>
						<div class="aside-body">
							<p>Delete fails and the row stays. That's intentional: the new schema broke a query, and only the Preview is affected. Your agent diagnoses it next.</p>
						</div>
					</details>
				</div>
			</div>

		</div>
	</article>

	{/* ─── Step 6: Observability ─── */}
	<article id="observability" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(6).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(6).label}</h2>
				<p class="stepcard-lede">Your agent finds the cause in the Preview's own logs.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="phase">
				<span class="phase-badge phase-badge--do">Connect</span>
				<div class="phase-content">
					<p>First, connect your agent to your Preview's logs. The starter repo already configures the read-only <strong>Workers Observability MCP server</strong> (<code>cloudflare-observability</code>), so you only need to sign in with Cloudflare once. Pick your agent:</p>
					<AgentPicker client:load agents={MCP_AGENTS} />
					<p>Then check it worked:</p>
					<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.checkObservability} />
					<p class="phase-note">Agent started before you cloned the repo? Restart it in the <code>worker-previews-starter</code> folder so it reads the config. Can't connect? Use the dashboard fallback at the end of this step.</p>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--why">Learn</span>
				<div class="phase-content">
					<p>Each Preview has its own Observability, separate from production. Every log line is tagged with the Preview's name (<code>$workers.preview.slug</code>), so your agent can read exactly this branch's errors without you copying anything.</p>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--do">Prompt</span>
				<div class="phase-content">
					<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.readPreviewLogs} />
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--verify">Verify</span>
				<div class="phase-content">
					<p>Your agent shows one or more <code>activity_log.delete_failed</code> events whose D1 error names the missing column, and explains why the delete query fails against the Preview schema. Found nothing? Logs can take a minute to arrive, so ask it to try again.</p>
				</div>
			</div>

			<details class="aside">
				<summary>No MCP? Find the error in the dashboard</summary>
				<div class="aside-body">
					<ol class="steps-inline">
						<li>Go to <strong>Workers &amp; Pages</strong> → your Worker.</li>
						<li>In the Worker header, open the dropdown that says <strong>Production</strong> and pick <code>isolate-preview-db</code>.</li>
						<li>Open <strong>Observability</strong> and switch on <strong>Live</strong>.</li>
					</ol>
					<Figure
						src="/screenshots/dash-env-dropdown.png"
						width={1400}
						height={456}
						alt="The Cloudflare dashboard Worker header with the environment dropdown open, showing Production and the isolate-preview-db branch."
						caption="Switch from Production to your branch. Production's logs won't show these errors."
					/>
					<ol class="steps-inline" start="4">
						<li>Click Delete again and open the failed <code>DELETE</code> request.</li>
						<li>Find <code>activity_log.delete_failed</code>. Its D1 error names the missing column. Paste the error into your agent before the Step 7 prompt.</li>
					</ol>
					<Figure
						src="/screenshots/dash-observability-delete-failed.png"
						width={1400}
						height={540}
						alt="The Observability tab with isolate-preview-db selected in the Worker header, listing error-level events for DELETE requests to the Preview URL."
						caption="Your branch's live events. Click one to see the D1 error."
					/>
				</div>
			</details>

		</div>
	</article>

	{/* ─── Step 7: Fix and merge ─── */}
	<article id="final" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(7).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(7).label}</h2>
				<p class="stepcard-lede">Your agent fixes the bug and re-tests the Preview. You approve the merge.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="phase">
				<span class="phase-badge phase-badge--do">Prompt</span>
				<div class="phase-content">
					<p>In the same agent session:</p>
					<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.diagnoseAndFix} />
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--verify">Verify</span>
				<div class="phase-content">
					<p>Your agent reports every request passing on the Preview, delete included. Check its evidence yourself:</p>
					<ul class="tight-list">
						<li>On the PR, the bot comment has a <strong>second deployment row</strong> for the agent's commit, but the <strong>Preview URL is the same</strong>.</li>
						<li>Refresh your Preview tab: delete works.</li>
						<li>Production still shows its original rows.</li>
					</ul>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--do">Approve</span>
				<div class="phase-content">
					<p>The agent built it and tested it, and the Preview showed you the result. Merging is your call. Merge before going to Step 8:</p>
					<CommandBlock client:load text={COMMANDS.mergePullRequest} />
					<details class="aside aside--agent">
						<summary>Or tell your agent you approve</summary>
						<div class="aside-body">
							<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.mergePullRequest} />
						</div>
					</details>
					<p>Workers Builds deploys <code>main</code> to production. Production keeps its seeded rows and delete still works there. Nothing from <code>workshop/</code> touched it.</p>
				</div>
			</div>
		</div>
	</article>

	{/* ─── Step 8: Your turn ─── */}
	<article id="your-turn" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(8).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(8).label}</h2>
				<p class="stepcard-lede">One sentence to your agent, one new, tested Preview.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="phase">
				<span class="phase-badge phase-badge--why">Learn</span>
				<div class="phase-content">
					<p>You configured Previews once. Now every branch gets one automatically, including branches your agent creates.</p>
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--do">Do</span>
				<div class="phase-content">
					<p>Hand your agent a small feature and let it take it all the way to a PR. Swap in your own idea:</p>
					<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.yourTurn} />
				</div>
			</div>

			<div class="phase">
				<span class="phase-badge phase-badge--verify">Verify</span>
				<div class="phase-content">
					<p>The new PR gets its own bot comment and a <strong>new Preview URL</strong> named after the new branch. Your agent hands you that URL along with what it checked there. Production and your first Preview's code are unchanged.</p>
					<p class="phase-note">The new Preview uses <code>workshop-preview-db</code> too: its binding is on <code>main</code> now. Isolated from production, shared between Previews.</p>
				</div>
			</div>
		</div>
	</article>

	{/* ─── Recap ─── */}
	<article id="recap" class="stepcard stepcard--wrapup">
		<div class="stepcard-head">
			<div class="stepcard-badge stepcard-badge--wrapup">
				<span class="stepcard-badge-num">✓</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">What you just did</h2>
				<p class="stepcard-lede">Deploy, isolate, break. Your agent tests, diagnoses, fixes. You approve.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<ul class="wrapup-list">
				<li>Your branch got its own Preview: its own URL, D1 database, and Observability.</li>
				<li>You tested a schema change there that production never saw.</li>
				<li>Your agent tested the Preview itself, read the Preview's own logs to find the bug, and fixed it. No copy-paste.</li>
				<li>The fix landed on the same Preview URL as a new deployment. The agent re-tested it there, and you approved the merge from that evidence. Production's data never changed.</li>
				<li>Every new branch, yours or your agent's, gets its own Preview automatically.</li>
			</ul>
			<div class="tip">
				<span class="tip-label">Take it home</span>
				<p>Copy <code>AGENTS.md</code> and the MCP config from your <code>worker-previews-starter</code> repo into your own Worker repos. Change the API section to match your app, and your agent will test and debug every branch on its Preview the same way.</p>
			</div>
			<p class="wrapup-p">Keep going: the <a href={LINKS.blog}>Worker Previews announcement</a> and the <a href={LINKS.docs}>Previews docs</a> (custom domains, secrets, per-branch resources).</p>
		</div>
	</article>

	{/* ─── Wrap-up ─── */}
	<article id="wrap-up" class="stepcard stepcard--wrapup">
		<div class="stepcard-head">
			<div class="stepcard-badge stepcard-badge--wrapup">
				<span class="stepcard-badge-num">✓</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">Clean up</h2>
				<p class="stepcard-lede">What stays after the PR closes.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<p class="wrapup-p">Keep <code>workshop-preview-db</code>. Its binding is now on <code>main</code>, so every future Preview of this Worker uses it: isolated from production, shared between Previews. For a separate database per branch, give that branch its own binding and apply the schema to it.</p>

			<details class="aside">
				<summary>Want everything gone?</summary>
				<div class="aside-body">
					<p>Closing the PR only removes the Preview. The repo, Worker, and both databases stay until you delete them. Default names:</p>
					<ul class="tight-list">
						<li>GitHub repo: <code>&lt;you&gt;/worker-previews-starter</code></li>
						<li>Worker: <code>worker-previews-starter</code></li>
						<li>Production D1: <code>activity-log-db</code></li>
						<li>Preview D1: <code>workshop-preview-db</code></li>
					</ul>
					<CommandBlock client:load text={COMMANDS.cleanup} />
					<p class="phase-note"><code>gh repo delete</code> needs the <code>delete_repo</code> scope. If it complains, run <code>gh auth refresh -s delete_repo</code>.</p>
					<details class="aside aside--agent">
						<summary>Or ask your agent</summary>
						<div class="aside-body">
							<PromptBlock client:load label="Copy this prompt into your agent" text={PROMPTS.cleanup} />
						</div>
					</details>
					<p>You can also delete the Worker and both databases from the Cloudflare dashboard.</p>
				</div>
			</details>
		</div>
	</article>
</BaseLayout>

