---
import Figure from "../components/Figure.astro";
import Hero from "../components/Hero.astro";
import { PromptBlock } from "../components/PromptBlock";
import { StepNav } from "../components/StepNav";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LEARNING_OBJECTIVES, LINKS, PROMPTS, REPO_URL, STEPS } from "../lib/site";

const stepByIndex = (i: number) => STEPS[i];
---

<BaseLayout>
	<Hero slot="hero" />
	<StepNav slot="nav" client:load />

	<section class="intro-card">
		<h2 class="intro-title">What you'll learn</h2>
		<ul class="intro-objectives">
			{LEARNING_OBJECTIVES.map((objective) => <li>{objective}</li>)}
		</ul>
	</section>

	{/* ─── Step 0: Check your setup ─── */}
	<article id="prereqs" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(0).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(0).label}</h2>
				<p class="stepcard-lede">Paste this into your coding agent. It checks your machine and helps you fix anything missing.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<ul class="step-facts" aria-label="What your agent will do">
				<li>
					<span class="step-facts-label">Checks</span>
					<span>Node, git, the GitHub CLI, and the cf CLI.</span>
				</li>
				<li>
					<span class="step-facts-label">Asks first</span>
					<span>Before it installs or updates anything.</span>
				</li>
				<li>
					<span class="step-facts-label">You sign in</span>
					<span>GitHub and Cloudflare logins open your browser. You run them.</span>
				</li>
			</ul>

			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.checkPrereqs} />

			<p class="step-success">You should see a table of your tools and <strong>Ready</strong>.</p>
		</div>
	</article>

	{/* ─── Step 1: Deploy to Cloudflare ─── */}
	<article id="deploy" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(1).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(1).label}</h2>
				<p class="stepcard-lede">One click creates your copy of the repo, a production D1 database, and a live Worker with Preview builds on.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="deploy-panel">
				<a
					href={`https://deploy.workers.cloudflare.com/?url=${REPO_URL}`}
					target="_blank"
					rel="noopener noreferrer"
					class="deploy-cta-link"
				>
					<img src="https://deploy.workers.cloudflare.com/button" alt="Deploy to Cloudflare" />
				</a>
				<ol class="deploy-panel-steps">
					<li><span>Pick a personal GitHub account</span></li>
					<li><span>Keep the default names</span></li>
					<li><span>Database: choose <strong>Create new</strong></span></li>
					<li><span>Click <strong>Deploy</strong></span></li>
				</ol>
			</div>

			<details class="aside">
				<summary>See each screen of the form</summary>
				<div class="aside-body">
					<Figure
						src="/screenshots/deploy-01-github.png"
						width={1400}
						height={647}
						alt="The Git account dropdown in the deploy form, listing connected GitHub and GitLab accounts and options to add a new connection."
						caption="1. Pick the Git account for your copy of the repo. Use a personal GitHub account; work organizations with SSO can block the Cloudflare GitHub app install."
					/>
					<Figure
						src="/screenshots/deploy-02-form.png"
						width={1400}
						height={639}
						alt="The deploy form with project name worker-previews-starter, Create new selected for the D1 database, and the database named activity-log-db."
						caption="2. [cf test] Keep the default project name (worker-previews-starter-cf). The form may show no D1 section for cloudflare.config.ts: cf deploy creates activity-log-db-cf itself."
					/>
					<Figure
						src="/screenshots/deploy-03-build-settings.png"
						width={1400}
						height={642}
						alt="The deploy form showing ENVIRONMENT set to production, an empty build command, deploy command npm run deploy, and preview command npx wrangler preview."
						caption="3. [cf test] Deploy command npm run deploy. Preview command npx cf previews deploy (not npx wrangler preview). Note what the form shows here."
					/>
					<Figure
						src="/screenshots/deploy-04-preview-settings.png"
						width={1400}
						height={646}
						alt="The bottom of the deploy form with Enable Preview builds switched on and Protect with Cloudflare Access switched off, next to the Deploy button."
						caption="4. Check that Enable Preview builds is on, then click Deploy."
					/>
				</div>
			</details>

			<p class="step-success"><strong>cf test:</strong> if the button can't handle <code>cloudflare.config.ts</code>, use the CLI fallback in the starter README (template → <code>npm run deploy</code> → connect Workers Builds), then carry on.</p>

			<p class="step-success">When the build says <strong>Success</strong>, click <strong>Visit</strong>. You should see a <strong>Production</strong> badge and three entries. Build log stuck? Refresh the page.</p>

			<p class="deploy-repo-link">Curious what you're deploying? The <a href={REPO_URL} target="_blank" rel="noopener noreferrer">starter repo</a> is on GitHub.</p>
		</div>
	</article>

	{/* ─── Step 2: Get the code ─── */}
	<article id="clone" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(2).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(2).label}</h2>
				<p class="stepcard-lede">The deploy button created a repo in your GitHub account and deployed it to Cloudflare. Your agent works on your machine, so get a local copy.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.clone} />

			<p class="step-success">You should see a short summary of the app and the folder's path.</p>

			<div class="step-required" role="note">
				<span class="step-required-icon" aria-hidden="true">↻</span>
				<div>
					<p class="step-required-title">Restart your agent inside that folder</p>
					<p class="step-required-body">Your agent gave you the commands. It only loads the repo's rules and log tools when it starts there, and the next steps need them.</p>
				</div>
			</div>
		</div>
	</article>

	{/* ─── Step 3: Configure Previews ─── */}
	<article id="isolate" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(3).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(3).label}</h2>
				<p class="stepcard-lede">Previews inherit your code, not your settings. A Preview never falls back to production's database, so until you give it one, it has none.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<div class="concept-diagram">
				<div class="concept-col">
					<span class="concept-col-head concept-col-head--prod">Production</span>
					<div class="concept-cell">code</div>
					<div class="concept-cell concept-cell--bind">DB → activity-log-db-cf</div>
				</div>
				<div class="concept-col">
					<span class="concept-col-head concept-col-head--preview">Preview</span>
					<div class="concept-cell concept-cell--inherit">code (inherited)</div>
					<div class="concept-cell concept-cell--empty">DB → nothing until you add it</div>
				</div>
			</div>

			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.configure} />

			<div class="tip">
				<span class="tip-label">Compare the two bindings</span>
				<p>The <code>DB</code> in the production <code>return</code> of <code>cloudflare.config.ts</code> points at <code>activity-log-db-cf</code>. The <code>DB</code> in the <code>ctx.isPreview</code> branch points at <code>workshop-preview-db-cf</code>. Same binding name, so the code doesn't change. Different database, so a Preview never touches production data.</p>
				<p>No extra config file this time: <code>cf d1 migrations apply</code> takes the Preview database's ID and <code>--dir preview-migrations</code>. Production applies <code>migrations/</code> after each deploy, so their schemas never mix.</p>
			</div>
		</div>
	</article>

	{/* ─── Step 4: Open your Preview ─── */}
	<article id="preview" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(4).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(4).label}</h2>
				<p class="stepcard-lede">Every branch you push gets its own Preview: a separate copy of your Worker, with its own URL, running this branch's code and settings. The pull request is where its URL shows up.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.openPullRequest} />

			<div class="tip">
				<span class="tip-label">Open both links</span>
				<p><strong>The PR first:</strong> scroll to the Cloudflare bot's comment. That's where your team finds the Preview.</p>
				<p><strong>Then the Preview URL:</strong> the badge says <strong>Preview</strong>, and the page says the database is connected but has no schema yet. That's your new Preview database: empty, and nothing to do with production's data. Keep this tab and production open. You'll compare them next.</p>
			</div>
			<Figure
				src="/screenshots/app-preview-needs-schema.png"
				width={960}
				height={360}
				alt="The Preview Activity Log with an orange Preview badge, explaining that its database is connected but doesn't have the workshop schema yet."
				caption="Expected: the new database is empty."
			/>
		</div>
	</article>

	{/* ─── Step 5: Apply and test ─── */}
	<article id="interact" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(5).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(5).label}</h2>
				<p class="stepcard-lede">Apply the Preview's own migrations, including a schema change production doesn't have, to a database production can't see.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.testPreview} />

			<div class="tip">
				<span class="tip-label">Try it yourself</span>
				<p><strong>Refresh the Preview tab:</strong> three rows mentioning <strong>Preview</strong>. Click <strong>Delete</strong> on one. It fails and the row stays. That's the bug your agent finds next.</p>
				<p><strong>Refresh the production tab:</strong> its entries are all still there. Nothing you did touched it.</p>
			</div>
			<Figure
				src="/screenshots/app-preview-delete-error.png"
				width={960}
				height={828}
				size="narrow"
				alt="The Preview Activity Log with three Preview seed rows and a red error: Delete failed. Your data is unchanged. Check this Preview's Observability logs."
				caption="What you'll see when you click Delete on the Preview."
			/>
		</div>
	</article>

	{/* ─── Step 6: Observability ─── */}
	<article id="observability" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(6).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(6).label}</h2>
				<p class="stepcard-lede">Each Preview has its own logs, tagged with its branch. Your agent reads them and finds the cause, without you copying a single error.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.readPreviewLogs} />

			<div class="step-required" role="note">
				<span class="step-required-icon" aria-hidden="true">↻</span>
				<div>
					<p class="step-required-title">Agent stopped to connect? Paste the prompt again</p>
					<p class="step-required-body">The first time, your agent may stop to connect to your logs. Sign in when it asks, and when Cloudflare asks which account to authorize, pick the one with your Worker. Restart your agent if it says to, then paste the same prompt again.</p>
				</div>
			</div>

			<div class="tip">
				<span class="tip-label">See it yourself</span>
				<p>Open the dashboard link your agent gives you. It goes straight to this Preview's logs. The <code>activity_log.delete_failed</code> events are there. Production's logs don't have them.</p>
				<p>No link? Open your Worker in the dashboard, switch the dropdown in its header from <strong>Production</strong> to <code>isolate-preview-db</code>, then open <strong>Observability</strong>.</p>
				<p>Agent couldn't connect? Copy the error from here and paste it into your agent instead.</p>
			</div>

			<details class="aside">
				<summary>Show me where</summary>
				<div class="aside-body">
					<Figure
						src="/screenshots/dash-env-dropdown.png"
						width={1400}
						height={456}
						alt="The Cloudflare dashboard Worker header with the environment dropdown open, showing Production and the isolate-preview-db branch."
						caption="Switch from Production to your branch."
					/>
					<Figure
						src="/screenshots/dash-observability-delete-failed.png"
						width={1400}
						height={540}
						alt="The Observability tab with isolate-preview-db selected in the Worker header, listing error-level events for DELETE requests to the Preview URL."
						caption="Your branch's events. Click one to see the D1 error."
					/>
				</div>
			</details>
		</div>
	</article>

	{/* ─── Step 7: Fix and merge ─── */}
	<article id="final" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(7).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(7).label}</h2>
				<p class="stepcard-lede">Your agent fixes the bug and proves it on the same Preview. Merging stays your call.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.diagnoseAndFix} />

			<div class="tip">
				<span class="tip-label">Review it yourself</span>
				<p><strong>On the PR:</strong> the bot's table has a new row for the agent's commit, but the Preview URL hasn't changed.</p>
				<p><strong>On the Preview:</strong> click Delete. It works now.</p>
				<p><strong>On production:</strong> nothing has changed yet.</p>
			</div>

			<h3 class="step-gate">Happy with it? Approve the merge</h3>
			<p class="step-gate-lede">The agent built it and tested it, but you decide what reaches production. Merge before the next step.</p>
			<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.mergePullRequest} />
		</div>
	</article>

	{/* ─── Step 8: Full flow ─── */}
	<article id="full-flow" class="stepcard">
		<div class="stepcard-head">
			<div class="stepcard-badge">
				<span class="stepcard-badge-num">{stepByIndex(8).num}</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">{stepByIndex(8).label}</h2>
				<p class="stepcard-lede">Everything you just did, in one prompt. Your agent builds a feature, opens a pull request, and tests it on its own Preview. The merge is still yours.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<PromptBlock client:load collapsed label="Edit the first line to your own idea, then copy" text={PROMPTS.yourTurn} />

			<div class="tip">
				<span class="tip-label">Try it yourself</span>
				<p><strong>Open the new Preview URL:</strong> your change is there, at a URL named after the new branch.</p>
				<p><strong>Open production:</strong> no change. It only updates when you merge.</p>
			</div>
		</div>
	</article>

	{/* ─── Wrap-up ─── */}
	<article id="recap" class="stepcard stepcard--wrapup">
		<div class="stepcard-head">
			<div class="stepcard-badge stepcard-badge--wrapup">
				<span class="stepcard-badge-num">✓</span>
			</div>
			<div class="stepcard-head-copy">
				<h2 class="stepcard-title">What you just did</h2>
				<p class="stepcard-lede">Deploy, isolate, break. Your agent tests, diagnoses, fixes. You approve.</p>
			</div>
		</div>

		<div class="stepcard-body">
			<ul class="wrapup-list">
				<li>Your branch got its own Preview: its own URL, database, and logs, isolated from production.</li>
				<li>Your agent tested it, found the bug in the Preview's own logs, and proved the fix on the same URL.</li>
				<li>You approved the merge from that evidence. Production's data never changed.</li>
			</ul>
			<div class="tip">
				<span class="tip-label">Take it home</span>
				<p>Copy <code>AGENTS.md</code> and the MCP config from your <code>worker-previews-starter-cf</code> repo into your own Worker repos. Change the API section to match your app, and your agent will test and debug every branch on its Preview the same way.</p>
			</div>
			<p class="wrapup-p">Keep going: the <a href={LINKS.blog}>Worker Previews announcement</a> and the <a href={LINKS.docs}>Previews docs</a> (custom domains, secrets, per-branch resources).</p>

			<h3 class="step-gate">Clean up</h3>
			<p class="step-gate-lede">Keep <code>workshop-preview-db-cf</code>: every future Preview of this Worker uses it, unless a branch points its Preview at its own database. Closing a PR only removes its Preview. The repo, Worker, and both databases stay until you delete them.</p>
			<details class="aside">
				<summary>Want everything gone?</summary>
				<div class="aside-body">
					<PromptBlock client:load collapsed label="Copy this prompt into your agent" text={PROMPTS.cleanup} />
					<p>You can also delete the Worker and both databases from the Cloudflare dashboard.</p>
				</div>
			</details>
		</div>
	</article>
</BaseLayout>

