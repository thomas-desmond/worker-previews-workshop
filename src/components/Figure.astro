---
/**
 * Figure. A captioned screenshot slot with two states from one API:
 *
 *  - Placeholder (no `src`): a labelled dashed box describing the screenshot
 *    that belongs here. Ships safely today; drop a real image in later by
 *    adding a `src`, with zero layout change.
 *  - Image (`src` given): a lazy-loaded <img> with the same caption.
 *
 * Images are click-to-enlarge: the button opens the shared <Lightbox />
 * dialog rendered once in BaseLayout.
 *
 * Pass `width`/`height` when you know them to avoid layout shift.
 * Use `size="narrow"` for tall, app-style screenshots so they don't
 * dominate the column.
 */
interface Props {
	src?: string;
	alt: string;
	caption?: string;
	/** Shown inside the placeholder box when there is no `src`. */
	placeholderLabel?: string;
	width?: number;
	height?: number;
	size?: "full" | "narrow";
}

const { src, alt, caption, placeholderLabel, width, height, size = "full" } = Astro.props;
---

<figure class:list={["figure", { "figure--narrow": size === "narrow" }]}>
	{
		src ? (
			<button type="button" class="figure-frame figure-zoom" data-lightbox-src={src} data-lightbox-alt={alt}>
				<img
					src={src}
					alt={alt}
					width={width}
					height={height}
					loading="lazy"
					decoding="async"
				/>
				<span class="figure-zoom-hint" aria-hidden="true">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path>
					</svg>
					Click to enlarge
				</span>
			</button>
		) : (
			<div class="figure-placeholder" role="img" aria-label={alt}>
				<span class="figure-placeholder-tag">Screenshot</span>
				<span class="figure-placeholder-label">
					{placeholderLabel ?? alt}
				</span>
			</div>
		)
	}
	{caption && <figcaption class="figure-cap">{caption}</figcaption>}
</figure>
